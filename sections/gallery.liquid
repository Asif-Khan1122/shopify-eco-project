{% style %}
  .gallery_section {
    width: 100%;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  .gallery_section .container {
    max-width: 1291px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .gallery_section .gallery_section_inner {
    display: flex;
    flex-direction: column;
  }

  .gallery_header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .gallery_heading {
    font-size: 34px;
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
    color: rgb(var(--color-foreground, 20, 20, 20));
  }

  .gallery_heading__accent {
    color: #8a6e63;
    margin-left: 8px;
  }

  .gallery_button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
    background-color: #7d8f6b;
    cursor: pointer;
    color: #ffffff;
    font-size: 14px;
    font-weight: 500;
    padding: 12px 26px;
    border-radius: 999px;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.2s ease;
  }

  .gallery_button:hover {
    background-color: #6c7c5c;
    transform: translateY(-1px);
  }

  .gallery_grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-rows: auto auto;
    gap: 20px;
  }

  .gallery_item--1,
  .gallery_item--2 {
    grid-column: span 2;
  }

  .gallery_item--3,
  .gallery_item--4,
  .gallery_item--5,
  .gallery_item--6 {
    grid-column: span 1;
  }

  .gallery_item {
    overflow: hidden;
    border-radius: 12px;
    aspect-ratio: 1 / 1;
  }

  .gallery_item--1 .gallery_item_image,
  .gallery_item--2 .gallery_item_image {
    aspect-ratio: 16 / 10;
  }

  .gallery_item_image,
  .gallery_item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 989px) {
    .gallery_section {
      margin-top: calc({{ section.settings.margin_top }}px * 0.5);
      margin-bottom: calc({{ section.settings.margin_bottom }}px * 0.5);
    }

    .gallery_grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery_item--1,
    .gallery_item--2,
    .gallery_item--3,
    .gallery_item--4,
    .gallery_item--5,
    .gallery_item--6 {
      grid-column: span 1;
    }

    .gallery_item--1 .gallery_item_image,
    .gallery_item--2 .gallery_item_image {
      aspect-ratio: 1 / 1;
    }
  }

  @media screen and (max-width: 599px) {
    .gallery_header {
      justify-content: center;
      gap: 16px;
      margin-bottom: 25px;
    }
    .gallery_button {
      width: 100%;
    }
    .gallery_grid {
      grid-template-columns: repeat(1, 1fr);
      gap: 10px;
    }
  }
{% endstyle %}
<div class="gallery_section color-{{ section.settings.color_scheme }}">
  <div class="container">
    <div class="gallery_section_inner">
      <div class="gallery_header">
        <h2 class="gallery_heading">
          {{ section.settings.heading }}
          <span class="gallery_heading__accent">{{ section.settings.heading_accent }}</span>
        </h2>

        {%- if section.settings.button_label != blank -%}
          <a
            {% if section.settings.button_link != blank %}
              href="{{ section.settings.button_link }}"
            {% else %}
              role="link" aria-disabled="true"
            {% endif %}
            class="gallery_button"
          >
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}
      </div>

      <div class="gallery_grid">
        {%- for block in section.blocks -%}
          <div class="gallery_item gallery_item--{{ forloop.index }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 990px) 45vw, 90vw',
                  widths: '400,600,800,1000,1200',
                  class: 'gallery_item_image',
                  alt: block.settings.image.alt
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'gallery_item_image placeholder' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Gallery grid",
  "tag": "section",
  "class": "section-gallery-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading accent word",
      "default": "Gallery"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View All Gallery"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Spacing & Layout"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Margin top",
      "default": 68
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Margin bottom",
      "default": 68
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Gallery image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Gallery grid",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
