{% style %}
  .choose_us {
    width: 100%;
    margin-top: {{ section.settings.margin_top }}px;
    margin-bottom: {{ section.settings.margin_bottom }}px;
  }

  .choose_us .container {
    max-width: 1380px;
    margin: 0 auto;
    padding: {{ section.settings.padding_block }}px {{ section.settings.padding_inline }}px;
    border-radius: 20px;
    background-color: {{ section.settings.bg_color }};

  }

  .choose_us .choose_us_main{
    max-width: 1240px;

  }

  .choose_us .choose_us_heading {
    text-align: center;
    font-size: clamp(34px, 4vw, 56px);
    font-weight: 700;
    font-family: 'Plus Jakarta Sans', sans-serif;
    color: #222222;
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .choose_us .choose_us_heading strong {
    color: {{ section.settings.highlight_color }};
    font-weight: 700;
  }

  .choose_us .choose_us_inner {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .choose_us .choose_us_card {
    padding: {{ section.settings.card_padding_top }}px 20px {{ section.settings.card_padding_bottom }}px;
    background: #ffffff;
    border: 1px solid #ECECEC;
    border-radius: 16px;
    box-shadow: 0 0 5px 0 rgba(0, 0, 0, 0.13);
  }

  .choose_us .choose_us_card .icon_wrap {
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 25px;
  }

  .choose_us .choose_us_card .icon_wrap img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .choose_us .choose_us_card h3 {
    font-size: clamp(18px, 3vw, 24px);
    font-weight: 600;
    color: #222222;
    margin-bottom: 25px;
    font-family: 'Plus Jakarta Sans', sans-serif;
    letter-spacing: 0;
  }

  .choose_us .choose_us_card p {
    font-size: 18px;
    line-height: 1.5;
    color: #666666;
  }

  @media (max-width: 1024px){
    .choose_us .choose_us_inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 749px){
    .choose_us .choose_us_main {
      padding: {{ section.settings.padding_block | times: 0.3 | round }}px {{ section.settings.padding_inline | times: 0.2 | round }}px;
    }

    .choose_us .choose_us_inner {
      grid-template-columns: 1fr;
      gap: 18px;
    }

    .choose_us .choose_us_card {
      border-radius: 14px;
      padding: 20px 16px;
    }

    .choose_us .choose_us_card .icon_wrap {
      width: 46px;
      height: 46px;
      margin-bottom: 12px;
    }
  }
{% endstyle %}

<section class="choose_us">
  <div class="container">
    <div class="choose_us_main">
      {% if section.settings.heading != blank %}
        <h2 class="choose_us_heading">{{ section.settings.heading }}</h2>
      {% endif %}

      <div class="choose_us_inner">
        {% for block in section.blocks %}
          <div class="choose_us_card" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <div class="icon_wrap">
                {{ block.settings.icon | image_url: width: 96 | image_tag: loading: 'lazy' }}
              </div>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Why Choose Us",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Why <strong>Choose Us</strong>"
    },
    {
      "type": "header",
      "content": "BG Color"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "BG Color",
      "default": "#fafafa"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlighted Word Color",
      "default": "#9C747C"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "label": "Margin Top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "label": "Margin Bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "padding_block",
      "label": "Padding Top/Bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Padding Left/Right",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 68
    },
    {
      "type": "range",
      "id": "card_padding_top",
      "label": "Card Padding Top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 25
    },
    {
      "type": "range",
      "id": "card_padding_bottom",
      "label": "Card Padding Bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Rooted In Local Knowledge"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "We specialize in Florida-native and climate-resilient plants, ensuring your garden or landscape thrives with minimal maintenance."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Choose Us",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
