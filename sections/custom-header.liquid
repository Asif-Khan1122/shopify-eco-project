<style>
    .custom_header img{
      width: 100%;
      height: auto;
      object-fit: contain;
      display: block;
    }
    .custom_header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      z-index: 2;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
    }

    .custom_header .container {
      max-width: {{ section.settings.container_width }}px;
      margin: 0 auto;
      padding: 0 20px;
    }

    .custom_header .custom_header_inner {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .custom_header .header_main {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      max-width: 48%;
    }

    .custom_header .custom_header_right {
      display: flex;
      gap: 20px;
      align-items: center;
      justify-content: flex-end;
      background-color: {{ section.settings.background_color }};
      padding: 8px 8px 8px 30px;
      border-radius: 40px;
    }

    .custom_header .custom_header_nav {
      display: flex;
    }

    .custom_header ul.custom_header_menu {
      display: flex;
      align-items: center;
      gap: clamp(16px, 4vw, 30px);
      list-style: none;
    }

    .custom_header a.custom_header_link {
      text-decoration: none;
      font-size: clamp(14px, 4vw, 18px);
      font-weight: 500;
      line-height: 1.4;
      transition: color 0.3s ease;
      white-space: nowrap;
      color: {{ section.settings.link_color }};
    }

    .custom_header a.custom_header_link.active,
    .custom_header a.custom_header_link:hover {
      color: {{ section.settings.link_color }};
      text-shadow: 0.3px 0 currentColor, -0.3px 0 currentColor;
    }

    .custom_header a.custom_header_shop_now {
      text-decoration: none;
      font-size: clamp(14px, 3vw, 18px);
      font-weight: 600;
      line-height: 1.2;
      vertical-align: middle;
      background-color: {{ section.settings.btn_background_color }};
      padding: 10px 30px;
      border-radius: 40px;
      color: #000;
    }

    .custom_header .custom_header_icons {
      display: flex;
      gap: 16px;
      align-items: center;
    }

    .custom_header .header_icon {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #000;
      transition: opacity 0.3s ease;
    }

    .custom_header .header_icon:hover {
      opacity: 0.7;
    }

    .custom_header .cart_count {
      position: absolute;
      top: -8px;
      right: -8px;
      background-color: #000;
      color: #fff;
      font-size: 10px;
      font-weight: 600;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      line-height: 1;
    }

    /* ===== HAMBURGER BUTTON ===== */
    .custom_header .hamburger_btn {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 5px;
      width: 30px;
      height: 24px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 0;
      z-index: 1001;
    }

    .custom_header .hamburger_btn span {
      display: block;
      width: 100%;
      height: 2px;
      background-color: #000;
      border-radius: 2px;
      transition: all 0.3s ease;
    }

    .custom_header .hamburger_btn.active span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .custom_header .hamburger_btn.active span:nth-child(2) {
      opacity: 0;
    }
    .custom_header .hamburger_btn.active span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    .custom_header .mobile_menu_overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.5);
      z-index: 998;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .custom_header .mobile_menu_overlay.active {
      display: block;
      opacity: 1;
    }

    /* ===== RESPONSIVE ===== */
    @media screen and (max-width: 989px) {
      .custom_header .header_main {
        flex-direction: row-reverse;
      }

      .custom_header .custom_header_logo {
        max-width: 60px;
        width: 100%;
      }
      .custom_header .hamburger_btn {
        display: flex;
      }

      .custom_header .custom_header_nav {
        position: fixed;
        top: 0;
        left: -100%;
        right: 0;
        width: 280px;
        max-width: 80%;
        background-color: #fff;
        z-index: 999;
        transition: right 0.3s ease;
        padding: 60px 30px;
        box-shadow: -4px 0 20px rgba(0, 0, 0, 0.1);
      }

      .custom_header .custom_header_nav.active {
        left: 0;
      }

      .custom_header ul.custom_header_menu {
        flex-direction: column;
        align-items: flex-start;
        gap: 24px;
        margin-top: 16px;
      }

      .custom_header a.custom_header_shop_now {
        padding: 8px 16px;
        font-size: 14px;
      }
    }

    @media screen and (max-width: 749px) {
      .custom_header .header_main {
        max-width: 55%;
      }
      .custom_header .custom_header_right {
        gap: 10px;
        padding: 6px 6px 6px 16px;
      }
      .custom_header .custom_header_icons {
        gap: 10px;
      }
    }

    @media screen and (max-width: 510px){
      .custom_header .custom_header_icons {
        display: none;
      }
      .custom_header .custom_header_right {
        padding: 6px;
      }
    }

    @media screen and (max-width: 989px) {
    .custom_header .custom_header_nav {
      width: 100%;
      max-width: 90%;
    }
  }
</style>

<header class="custom_header">
  <div class="container">
    <div class="custom_header_inner">
      <div class="header_main">
        <div class="custom_header_logo">
          {% if section.settings.logo %}
            <a href="{{ routes.root_url }}">
              <img
                src="{{ section.settings.logo | image_url }}"
                alt="{{ section.settings.logo_alt | escape }}"
                width="{{ section.settings.logo_width }}"
                height="{{ section.settings.logo_height }}"
              >
            </a>
          {% endif %}
        </div>

        <!-- Hamburger Button (mobile only) -->
        <button class="hamburger_btn" id="hamburgerBtn" aria-label="Open Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>

        <!-- Nav / Menu (becomes drawer on mobile) -->
        <div class="custom_header_nav" id="customHeaderNav">
          <ul class="custom_header_menu">
            {% for block in section.blocks %}
              <li {{ block.shopify_attributes }}>
                <a
                  href="{{ block.settings.button_link }}"
                  class="custom_header_link {% if forloop.first %}active{% endif %}"
                >
                  {{ block.settings.button_text }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>

      <div class="custom_header_right">
        <div class="custom_header_icons">
          <a href="{{ routes.cart_url }}" class="header_icon" aria-label="Cart">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            {% if cart.item_count > 0 %}
              <span class="cart_count">{{ cart.item_count }}</span>
            {% endif %}
          </a>

          <a href="/wishlist" class="header_icon" aria-label="Wishlist">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
          </a>
        </div>

        <a href="{{ section.settings.shop_now_link }}" class="custom_header_shop_now">
          {{ section.settings.shop_now_text }}
        </a>
      </div>
    </div>
  </div>

  <!-- Overlay background for mobile menu -->
  <div class="mobile_menu_overlay" id="mobileMenuOverlay"></div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    var hamburgerBtn = document.getElementById('hamburgerBtn');
    var mobileNav = document.getElementById('customHeaderNav');
    var overlay = document.getElementById('mobileMenuOverlay');

    function openMenu() {
      hamburgerBtn.classList.add('active');
      mobileNav.classList.add('active');
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      hamburgerBtn.classList.remove('active');
      mobileNav.classList.remove('active');
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    hamburgerBtn.addEventListener('click', function () {
      if (mobileNav.classList.contains('active')) {
        closeMenu();
      } else {
        openMenu();
      }
    });

    overlay.addEventListener('click', closeMenu);
  });
</script>

{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "color",
      "id": "btn_background_color",
      "label": "Button Background Color",
      "default": "#FBF8E8"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo Width",
      "min": 85,
      "max": 255,
      "step": 10,
      "unit": "px",
      "default": 85
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo Height",
      "min": 45,
      "max": 120,
      "step": 5,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "container_width",
      "label": "Container Width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1260
    },
    {
      "type": "text",
      "id": "logo_alt",
      "label": "Logo Alt Text"
    },
    {
      "type": "text",
      "id": "shop_now_text",
      "label": "Shop Now Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "shop_now_link",
      "label": "Shop Now Link"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#d1d7de"
    }
  ],
  "blocks": [
    {
      "type": "menu_item",
      "name": "Menu Item",
      "settings": [
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Home"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Header",
      "category": "Custom"
    }
  ]
}
{% endschema %}
