{% assign page_key = 'default' %}

{% if request.path contains 'about' %}
  {% assign page_key = 'about' %}
{% elsif template.name == 'page' and page.handle == 'about' %}
  {% assign page_key = 'about' %}
{% elsif template.name == 'page' and page.handle == 'about-us' %}
  {% assign page_key = 'about' %}

{% elsif template.name == 'product' %}
  {% assign page_key = 'product_detail' %}

{% elsif template.name == 'collection' %}
  {% assign page_key = 'product_listing' %}
{% elsif template.name == 'page' and page.handle == 'product' %}
  {% assign page_key = 'product_listing' %}
{% elsif template.name == 'page' and page.handle == 'products' %}
  {% assign page_key = 'product_listing' %}

{% elsif template.name == 'page' and page.handle == 'contact' %}
  {% assign page_key = 'contact' %}
{% elsif template.name == 'page' and page.handle == 'contact-us' %}
  {% assign page_key = 'contact' %}
{% elsif template.name == 'contact' %}
  {% assign page_key = 'contact' %}
{% endif %}

{% comment %} COLOR / SETTINGS MAP PER PAGE {% endcomment %}
{% case page_key %}
  {% when 'about' %}
    {% assign btn_bg = section.settings.about_btn_background_color | default: '#4A90D9' %}
    {% assign btn_text = section.settings.about_btn_text_color | default: '#FFFFFF' %}
    {% assign btn_hover = section.settings.about_btn_hover_background | default: '#357ABD' %}
    {% assign link_color = section.settings.about_link_color | default: '#FFFFFF' %}
    {% assign link_hover = section.settings.about_link_hover_color | default: '#CCCCCC' %}
    {% assign right_bg = section.settings.about_right_bg | default: 'transparent' %}
    {% assign logo_desktop = section.settings.about_logo | default: section.settings.logo %}
    {% assign logo_mobile = section.settings.about_mobile_logo | default: section.settings.mobile_logo %}
    {% assign icon_color = section.settings.about_icon_color | default: '#FFFFFF' %}
    {% assign icon_color_scrolled = section.settings.about_icon_color_scrolled | default: '#000000' %}
    {% assign scrolled_bg = section.settings.about_scrolled_background | default: '#FFFFFF' %}
    {% assign scrolled_link_color = section.settings.about_scrolled_link_color | default: '#000000' %}
    {% assign scrolled_link_hover = section.settings.about_scrolled_link_hover | default: '#333333' %}
    {% assign scrolled_btn_bg = section.settings.about_scrolled_btn_bg | default: '#4A90D9' %}
    {% assign scrolled_btn_text = section.settings.about_scrolled_btn_text | default: '#FFFFFF' %}
    {% assign scrolled_btn_hover = section.settings.about_scrolled_btn_hover | default: '#357ABD' %}
    {% assign page_class = 'about-page' %}

  {% when 'product_listing' %}
    {% assign btn_bg = section.settings.product_btn_background_color | default: '#3D4A2F' %}
    {% assign btn_text = section.settings.product_btn_text_color | default: '#FFFFFF' %}
    {% assign btn_hover = section.settings.product_btn_hover_background | default: '#2C3620' %}
    {% assign link_color = section.settings.product_link_color | default: '#FFFFFF' %}
    {% assign link_hover = section.settings.product_link_hover_color | default: '#CCCCCC' %}
    {% assign right_bg = section.settings.product_right_bg | default: 'transparent' %}
    {% assign logo_desktop = section.settings.product_logo | default: section.settings.logo %}
    {% assign logo_mobile = section.settings.product_mobile_logo | default: section.settings.mobile_logo %}
    {% assign icon_color = section.settings.product_icon_color | default: '#FFFFFF' %}
    {% assign icon_color_scrolled = section.settings.product_icon_color_scrolled | default: '#000000' %}
    {% assign scrolled_bg = section.settings.product_scrolled_background | default: '#FFFFFF' %}
    {% assign scrolled_link_color = section.settings.product_scrolled_link_color | default: '#000000' %}
    {% assign scrolled_link_hover = section.settings.product_scrolled_link_hover | default: '#333333' %}
    {% assign scrolled_btn_bg = section.settings.product_scrolled_btn_bg | default: '#3D4A2F' %}
    {% assign scrolled_btn_text = section.settings.product_scrolled_btn_text | default: '#FFFFFF' %}
    {% assign scrolled_btn_hover = section.settings.product_scrolled_btn_hover | default: '#2C3620' %}
    {% assign page_class = 'product-page' %}

  {% when 'product_detail' %}
    {% assign btn_bg = section.settings.pd_btn_background_color | default: '#1F2B1A' %}
    {% assign btn_text = section.settings.pd_btn_text_color | default: '#FFFFFF' %}
    {% assign btn_hover = section.settings.pd_btn_hover_background | default: '#141C11' %}
    {% assign link_color = section.settings.pd_link_color | default: '#FFFFFF' %}
    {% assign link_hover = section.settings.pd_link_hover_color | default: '#CCCCCC' %}
    {% assign right_bg = section.settings.pd_right_bg | default: 'transparent' %}
    {% assign logo_desktop = section.settings.pd_logo | default: section.settings.logo %}
    {% assign logo_mobile = section.settings.pd_mobile_logo | default: section.settings.mobile_logo %}
    {% assign icon_color = section.settings.pd_icon_color | default: '#FFFFFF' %}
    {% assign icon_color_scrolled = section.settings.pd_icon_color_scrolled | default: '#000000' %}
    {% assign scrolled_bg = section.settings.pd_scrolled_background | default: '#FFFFFF' %}
    {% assign scrolled_link_color = section.settings.pd_scrolled_link_color | default: '#000000' %}
    {% assign scrolled_link_hover = section.settings.pd_scrolled_link_hover | default: '#333333' %}
    {% assign scrolled_btn_bg = section.settings.pd_scrolled_btn_bg | default: '#1F2B1A' %}
    {% assign scrolled_btn_text = section.settings.pd_scrolled_btn_text | default: '#FFFFFF' %}
    {% assign scrolled_btn_hover = section.settings.pd_scrolled_btn_hover | default: '#141C11' %}
    {% assign page_class = 'product-detail-page' %}

  {% when 'contact' %}
    {% assign btn_bg = section.settings.contact_btn_background_color | default: '#2C2C2C' %}
    {% assign btn_text = section.settings.contact_btn_text_color | default: '#F4EFE3' %}
    {% assign btn_hover = section.settings.contact_btn_hover_background | default: '#1A1A1A' %}
    {% assign link_color = section.settings.contact_link_color | default: '#2C2C2C' %}
    {% assign link_hover = section.settings.contact_link_hover_color | default: '#555555' %}
    {% assign right_bg = section.settings.contact_right_bg | default: '#F4EFE3' %}
    {% assign logo_desktop = section.settings.contact_logo | default: section.settings.logo %}
    {% assign logo_mobile = section.settings.contact_mobile_logo | default: section.settings.mobile_logo %}
    {% assign icon_color = section.settings.contact_icon_color | default: '#2C2C2C' %}
    {% assign icon_color_scrolled = section.settings.contact_icon_color_scrolled | default: '#000000' %}
    {% assign scrolled_bg = section.settings.contact_scrolled_background | default: '#FFFFFF' %}
    {% assign scrolled_link_color = section.settings.contact_scrolled_link_color | default: '#000000' %}
    {% assign scrolled_link_hover = section.settings.contact_scrolled_link_hover | default: '#333333' %}
    {% assign scrolled_btn_bg = section.settings.contact_scrolled_btn_bg | default: '#2C2C2C' %}
    {% assign scrolled_btn_text = section.settings.contact_scrolled_btn_text | default: '#F4EFE3' %}
    {% assign scrolled_btn_hover = section.settings.contact_scrolled_btn_hover | default: '#1A1A1A' %}
    {% assign page_class = 'contact-page' %}

  {% else %}
    {% comment %} Home / default {% endcomment %}
    {% assign btn_bg = section.settings.btn_background_color | default: '#FBF8E8' %}
    {% assign btn_text = section.settings.btn_text_color | default: '#000000' %}
    {% assign btn_hover = section.settings.btn_hover_background | default: '#e8e5d5' %}
    {% assign link_color = section.settings.link_color | default: '#000000' %}
    {% assign link_hover = section.settings.link_hover_color | default: '#000000' %}
    {% assign right_bg = section.settings.background_color | default: '#d1d7de' %}
    {% assign logo_desktop = section.settings.logo %}
    {% assign logo_mobile = section.settings.mobile_logo %}
    {% assign icon_color = '#000000' %}
    {% assign icon_color_scrolled = '#000000' %}
    {% assign scrolled_bg = section.settings.scrolled_background_color | default: '#ffffff' %}
    {% assign scrolled_link_color = '#000000' %}
    {% assign scrolled_link_hover = '#000000' %}
    {% assign scrolled_btn_bg = btn_bg %}
    {% assign scrolled_btn_text = btn_text %}
    {% assign scrolled_btn_hover = btn_hover %}
    {% assign page_class = '' %}
{% endcase %}

{% style %}
  .custom_header img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
    max-height: 91px;
  }

  .custom_header {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    z-index: 2;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background-color: transparent;
    transition: background-color 0.7s ease, box-shadow 0.7s ease, transform 0.7s ease;
  }

  {% if section.settings.enable_sticky_header %}
    .custom_header.is_scrolled {
      background-color: {{ scrolled_bg }};
      border-bottom: 1px solid #EDEAE0;
    }

    {% if section.settings.sticky_style == "slide_down" %}
      .custom_header.is_scrolled {
        animation: slideDown 0.3s ease forwards;
      }
      @keyframes slideDown {
        from { transform: translateY(-100%); }
        to { transform: translateY(0); }
      }
    {% elsif section.settings.sticky_style == "fade_in" %}
      .custom_header.is_scrolled {
        animation: fadeIn 0.3s ease forwards;
      }
      @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
      }
    {% endif %}
  {% else %}
    .custom_header {
      position: relative;
    }
  {% endif %}

  .custom_header .container {
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .custom_header .custom_header_inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .custom_header .header_main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 48%;
  }

  .custom_header .custom_header_right {
    display: flex;
    gap: 20px;
    align-items: center;
    justify-content: flex-end;
    background-color: {{ right_bg }};
    padding: 8px 8px 8px 30px;
    border-radius: 40px;
    transition: background-color 0.3s ease;
  }

  .custom_header .custom_header_nav {
    display: flex;
  }

  .custom_header ul.custom_header_menu {
    display: flex;
    align-items: center;
    gap: {{ section.settings.menu_gap }}px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .custom_header a.custom_header_link {
    text-decoration: none;
    font-size: clamp(14px, 4vw, 18px);
    font-weight: 500;
    line-height: 1.4;
    transition: color 0.3s ease;
    white-space: nowrap;
    color: {{ link_color }};
    position: relative;
  }

  .custom_header a.custom_header_link.active,
  .custom_header a.custom_header_link:hover {
    color: {{ link_hover }};
    text-shadow: 0.3px 0 currentColor, -0.3px 0 currentColor;
  }

  .custom_header a.custom_header_link.active::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    background-color: {{ link_hover }};
    transition: width 0.3s ease;
  }

  .custom_header.is_scrolled a.custom_header_link {
    color: {{ scrolled_link_color }};
  }

  .custom_header.is_scrolled a.custom_header_link.active,
  .custom_header.is_scrolled a.custom_header_link:hover {
    color: {{ scrolled_link_hover }};
    text-shadow: 0.3px 0 currentColor, -0.3px 0 currentColor;
  }

  .custom_header.is_scrolled a.custom_header_link.active::after {
    background-color: {{ scrolled_link_hover }};
  }

  .custom_header a.custom_header_shop_now {
    text-decoration: none;
    font-size: clamp(14px, 3vw, 18px);
    font-weight: 600;
    line-height: 1.2;
    vertical-align: middle;
    background-color: {{ btn_bg }};
    color: {{ btn_text }};
    padding: 10px 30px;
    border-radius: 40px;
    transition: background-color 0.3s ease, color 0.3s ease, transform 0.2s ease;
    display: inline-block;
    border: none;
    cursor: pointer;
  }

  .custom_header a.custom_header_shop_now:hover {
    background-color: {{ btn_hover }};
    transform: scale(1.02);
  }

  .custom_header a.custom_header_shop_now:active {
    transform: scale(0.98);
  }

  .custom_header.is_scrolled a.custom_header_shop_now {
    background-color: {{ scrolled_btn_bg }};
    color: {{ scrolled_btn_text }};
  }

  .custom_header.is_scrolled a.custom_header_shop_now:hover {
    background-color: {{ scrolled_btn_hover }};
  }

  .custom_header .custom_header_icons {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .custom_header .header_icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: {{ icon_color }};
    transition: color 0.3s ease, opacity 0.3s ease;
  }

  .custom_header .header_icon:hover {
    opacity: 0.7;
  }

  .custom_header.is_scrolled .header_icon {
    color: {{ icon_color_scrolled }};
  }

  .custom_header .cart_count {
    position: absolute;
    top: -8px;
    right: -8px;
    background-color: {{ btn_bg }};
    color: {{ btn_text }};
    font-size: 10px;
    font-weight: 600;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .custom_header.is_scrolled .cart_count {
    background-color: {{ scrolled_btn_bg }};
    color: {{ scrolled_btn_text }};
  }

  .custom_header .hamburger_btn {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 25px;
    height: 24px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    z-index: 1001;
  }

  .custom_header .hamburger_btn span {
    display: block;
    width: 100%;
    height: 2px;
    background-color: {{ icon_color }};
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .custom_header .hamburger_btn.active span {
    background-color: #000000 !important;
  }

  .custom_header.is_scrolled .hamburger_btn span {
    background-color: {{ icon_color_scrolled }};
  }

  @media (max-width: 989px) {
    .custom_header a.custom_header_link {
      color: #000;
    }
  }

  @media (max-width: 768px) {
    .custom_header img {
      max-height: 50px;
      width: fit-content;
    }
    .custom_header {
      padding-top: 6px;
      padding-bottom: 6px;
    }
  }

  .custom_header .hamburger_btn.active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .custom_header .hamburger_btn.active span:nth-child(2) {
    opacity: 0;
  }
  .custom_header .hamburger_btn.active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .custom_header .mobile_menu_overlay {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.5);
    z-index: 998;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .custom_header .mobile_menu_overlay.active {
    display: block;
    opacity: 1;
  }

  @media screen and (max-width: 989px) {
    .custom_header .header_main {
      flex-direction: row-reverse;
    }

    .custom_header .custom_header_nav {
      width: 100%;
      max-width: 90%;
    }

    .custom_header .custom_header_logo {
      max-width: {{ section.settings.logo_mobile_width }}px;
      width: 100%;
    }

    .custom_header .hamburger_btn {
      display: flex;
    }

    .custom_header .custom_header_nav {
      position: fixed;
      top: 0;
      {% if section.settings.mobile_collapsible %}
        left: -100%;
      {% else %}
        left: 0;
        transform: translateX(-100%);
      {% endif %}
      width: 280px;
      max-width: 80%;
      background-color: {{ section.settings.mobile_menu_background }};
      z-index: 999;
      transition: transform 0.3s ease, left 0.3s ease;
      padding: 60px 30px;
      box-shadow: 4px 0 20px rgba(0, 0, 0, 0.1);
      height: 100vh;
      overflow-y: auto;
    }

    .custom_header .custom_header_nav.active {
      {% if section.settings.mobile_collapsible %}
        left: 0;
      {% else %}
        transform: translateX(0);
      {% endif %}
    }

    .custom_header ul.custom_header_menu {
      flex-direction: column;
      align-items: flex-start;
      gap: 24px;
      margin-top: 16px;
    }

    .custom_header a.custom_header_shop_now {
      padding: 8px 16px;
      font-size: 14px;
    }

    .custom_header a.custom_header_link.active::after {
      bottom: -2px;
    }
  }

  @media screen and (max-width: 749px) {
    .custom_header .header_main {
      max-width: 55%;
    }
    .custom_header .custom_header_right {
      gap: 10px;
      padding: 6px 6px 6px 16px;
    }
    .custom_header .custom_header_icons {
      gap: 10px;
    }
  }

  @media screen and (max-width: 510px) {
    .custom_header .custom_header_icons {
      display: none;
    }
    .custom_header .custom_header_right {
      padding: 6px;
    }
  }
{% endstyle %}

<header class="custom_header {{ page_class }}">
  <div class="container">
    <div class="custom_header_inner">
      <div class="header_main">
        <div class="custom_header_logo">
          {% if logo_desktop %}
            <a href="{{ routes.root_url }}">
              {% if logo_mobile %}
                <img
                  src="{{ logo_desktop | image_url }}"
                  width="{{ section.settings.logo_width }}"
                  height="{{ section.settings.logo_height }}"
                  alt="{{ logo_desktop.alt | default: shop.name }}"
                  class="desktop-logo"
                  loading="lazy"
                >
                <img
                  src="{{ logo_mobile | image_url }}"
                  width="{{ section.settings.logo_mobile_width }}"
                  height="{{ section.settings.logo_height }}"
                  alt="{{ logo_mobile.alt | default: shop.name }}"
                  class="mobile-logo"
                  loading="lazy"
                  style="display: none;"
                >
                <style>
                  @media screen and (max-width: 749px) {
                    .custom_header .desktop-logo {
                      display: none;
                    }
                    .custom_header .mobile-logo {
                      display: block;
                    }
                  }
                </style>
              {% else %}
                <img
                  src="{{ logo_desktop | image_url }}"
                  width="{{ section.settings.logo_width }}"
                  height="{{ section.settings.logo_height }}"
                  alt="{{ logo_desktop.alt | default: shop.name }}"
                  loading="lazy"
                >
              {% endif %}
            </a>
          {% endif %}
        </div>

        <button class="hamburger_btn" id="hamburgerBtn" aria-label="Toggle Menu">
          <span></span><span></span><span></span>
        </button>

        <div class="custom_header_nav" id="customHeaderNav">
          <ul class="custom_header_menu">
            {% if section.settings.menu != blank %}
              {% for link in linklists[section.settings.menu].links %}
                {% assign link_url = link.url %}
                {% assign is_active = false %}

                {% if link.handle == 'home' or link_url == '/' %}
                  {% if request.path == '/' %}
                    {% assign is_active = true %}
                  {% endif %}
                {% elsif request.path contains link_url %}
                  {% assign is_active = true %}
                {% elsif template.name == 'page' and link.handle == page.handle %}
                  {% assign is_active = true %}
                {% elsif template.name == 'collection' and link.handle == collection.handle %}
                  {% assign is_active = true %}
                {% elsif template.name == 'product' and link.handle == product.handle %}
                  {% assign is_active = true %}
                {% endif %}

                <li>
                  <a
                    href="{{ link.url }}"
                    class="custom_header_link {% if is_active %}active{% endif %}"
                    style="font-weight: normal;"
                    {% if link.target == '_blank' %}
                      target="_blank" rel="noopener noreferrer"
                    {% endif %}
                  >
                    {{ link.title }}
                  </a>
                </li>
              {% endfor %}
            {% endif %}
          </ul>
        </div>
      </div>

      <div class="custom_header_right">
        <div class="custom_header_icons">
          <a href="{{ routes.cart_url }}" class="header_icon" aria-label="Cart">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="9" cy="21" r="1"></circle>
              <circle cx="20" cy="21" r="1"></circle>
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
            </svg>
            {% if cart.item_count > 0 %}
              <span class="cart_count">{{ cart.item_count }}</span>
            {% endif %}
          </a>

          {% if settings.wishlist_enabled or shop.metafields.wishlist %}
            <a href="/pages/wishlist" class="header_icon" aria-label="Wishlist">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="22"
                height="22"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
              </svg>
            </a>
          {% endif %}
        </div>

        {% if section.settings.shop_now_text != blank and section.settings.shop_now_link != blank %}
          <a href="{{ section.settings.shop_now_link }}" class="custom_header_shop_now">
            {{ section.settings.shop_now_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="mobile_menu_overlay" id="mobileMenuOverlay"></div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    var navLinks = document.querySelectorAll('.custom_header_link');
    var currentUrl = window.location.pathname;

    navLinks.forEach(function(link) {
      var linkUrl = link.getAttribute('href');
      link.classList.remove('active');

      if (linkUrl === currentUrl ||
          (linkUrl === '/' && currentUrl === '/') ||
          (currentUrl.includes(linkUrl) && linkUrl !== '/')) {
        link.classList.add('active');
      }
    });

    var hamburgerBtn = document.getElementById('hamburgerBtn');
    var mobileNav = document.getElementById('customHeaderNav');
    var overlay = document.getElementById('mobileMenuOverlay');
    var header = document.querySelector('.custom_header');

    function openMenu() {
      hamburgerBtn.classList.add('active');
      mobileNav.classList.add('active');
      overlay.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
      hamburgerBtn.classList.remove('active');
      mobileNav.classList.remove('active');
      overlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    if (hamburgerBtn) {
      hamburgerBtn.addEventListener('click', function() {
        if (mobileNav.classList.contains('active')) {
          closeMenu();
        } else {
          openMenu();
        }
      });
    }

    if (overlay) overlay.addEventListener('click', closeMenu);

    function handleScroll() {
      {% if section.settings.enable_sticky_header %}
        if (window.scrollY > 20) {
          header.classList.add('is_scrolled');
        } else {
          header.classList.remove('is_scrolled');
        }
      {% endif %}
    }

    window.addEventListener('scroll', handleScroll);
    handleScroll();

    var navLinksMobile = mobileNav.querySelectorAll('a');
    navLinksMobile.forEach(function(link) {
      link.addEventListener('click', function() {
        if (window.innerWidth <= 989) closeMenu();
      });
    });
  });
</script>

