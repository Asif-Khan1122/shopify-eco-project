<style>
  .custom_marquee {
    overflow: hidden;
    position: relative;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    margin-top: clamp(-8px, -2vw, -20px);
    z-index: 2;
    background-color: {{ section.settings.background_color }};
  }

  .custom_marquee .container {
    max-width: 100%;
    margin: 0 auto;
    display: flex;
  }

  .custom_marquee .custom_marquee_inner {
    display: inline-flex;
    width: max-content;
    white-space: nowrap;
    flex-shrink: 0;
    align-items: center;
    will-change: transform;
    animation: scroll {{ section.settings.scroll_speed }}s linear infinite;
  }

  .custom_marquee:hover .custom_marquee_inner {
    animation-play-state: paused;
  }

  @keyframes scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .custom_marquee  img {
    height: clamp(36px, 3vw, 60px);
    width: auto;
    display: block;
    object-fit: contain;
  }

  .custom_marquee .marquee_image {
    margin: 0 50px;
  }
</style>

<section class="custom_marquee">
  <div class="container">
    <div class="custom_marquee_inner">
      {% for block in section.blocks %}
        <div class="marquee_image" {{ block.shopify_attributes }}>
          {% if block.settings.marquee_image != blank %}
            <img
              src="{{ block.settings.marquee_image | image_url }}"
              width="{{ block.settings.marquee_image.width }}"
              height="{{ block.settings.marquee_image.height }}"
              alt="{{ block.settings.marquee_image.alt | escape }}"
              loading="lazy"
            >
          {% endif %}
        </div>
      {% endfor %}

      {% for block in section.blocks %}
        <div class="marquee_image">
          {% if block.settings.marquee_image != blank %}
            <img
              src="{{ block.settings.marquee_image | image_url }}"
              width="{{ block.settings.marquee_image.width }}"
              height="{{ block.settings.marquee_image.height }}"
              alt="{{ block.settings.marquee_image.alt | escape }}"
              loading="lazy"
            >
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Marquee",
  "settings": [
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll Speed (seconds per loop)",
      "min": 10,
      "max": 60,
      "default": 20,
      "step": 5,
      "unit": "s"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 4,
      "max": 32,
      "step": 4,
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 4,
      "max": 32,
      "step": 4,
      "default": 20
    },
    {
      "type": "header",
      "content": "BG Color"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section BG",
      "default": "#9C747C"
    },
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Marquee Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "marquee_image",
          "label": "Marquee Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Marquee",
      "category": "Custom"
    }
  ]
}
{% endschema %}
